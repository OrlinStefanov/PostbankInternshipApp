{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=bintool.db"
  },
  "Jwt": {
    "Issuer": "BinTool",
    "Audience": "BinTool",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // Every executed statement is echoed at Information, which buries the application's
      // own events under SQL - startup alone produced over 200 lines. Raised to Warning so
      // the default log is readable; drop it back to Information when a query needs
      // watching, or set it in appsettings.Development.json only.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",

      // The application's own namespaces, named explicitly so the level they log at is a
      // deliberate setting rather than whatever Default happens to be.
      "BinTool": "Information"
    }
  },
  "AllowedHosts": "*"
}
