{
  // Development-only signing key. It is committed on purpose so the project runs
  // straight after a clone; it is not a secret and must never be used elsewhere.
  // Outside Development, supply Jwt:Key via user secrets or an environment variable -
  // startup fails if it is missing or shorter than 32 bytes.
  "Jwt": {
    "Key": "bintool-development-signing-key-do-not-use-in-production"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
