@inject IWebHostEnvironment Environment

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Versioned("bootstrap/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Versioned("app.css")" />
    <link rel="stylesheet" href="@ScopedStyles" />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* Blocking, and in the head on purpose: the attribute has to be on <html> before the
       first paint, or every reload shows a frame of the light theme before turning dark.
       No stored choice leaves the attribute off, which hands the decision to the
       prefers-color-scheme media query in app.css. *@
    <script src="@Versioned("theme.js")"></script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Static files are served with an ETag but no Cache-Control, so a stale app.css can be paired
    // with a fresh scoped bundle - which drops every var(--app-*) and paints white text on white.
    // Stamping each URL with the file's own timestamp makes a changed file a different URL.

    private string Versioned(string path)
    {
        var file = Environment.WebRootFileProvider.GetFileInfo(path);

        return file.Exists ? $"{path}?v={file.LastModified.UtcTicks}" : path;
    }

    // The scoped-CSS bundle is generated at build time rather than served out of wwwroot, so it is
    // stamped with the build itself - which is exactly when its contents change.
    private string ScopedStyles
    {
        get
        {
            var assembly = typeof(App).Assembly.Location;
            var stamp = string.IsNullOrEmpty(assembly)
                ? DateTime.UtcNow.Ticks
                : File.GetLastWriteTimeUtc(assembly).Ticks;

            return $"BinTool.UI.styles.css?v={stamp}";
        }
    }
}
