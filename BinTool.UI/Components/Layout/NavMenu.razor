<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BinTool</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @* A link is only shown to someone whose role can actually follow it. The route
           itself is guarded too, so hiding it is presentation, not the control. *@
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="bin-ranges">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> BIN Ranges
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@Permissions.BinRangesImport">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="import">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> BIN Import
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@Permissions.RolesManage">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="access-control">
                        <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Access Control
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>
