@*
    Every label is wrapped in its own element so the icon rail can drop the text
    without losing the icon. The `title` on each link is what carries the label
    once it is hidden, so a rail item still says what it is on hover.

    Items are grouped under section headings. A heading belongs to its group
    rather than to any one link, so a user whose role hides every link in a
    group would be left with a floating heading - `.nav-group:not(:has(...))`
    in the stylesheet drops the whole block in that case.
*@

<div class="nav-head">
    <a class="brand" href="">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-text">
            <span class="brand-name">Postbank</span>
            <span class="brand-sub">Bulgaria Classifier</span>
        </span>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav-list">
        <div class="nav-group">
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                    <span class="ico ico-home nav-icon" aria-hidden="true"></span>
                    <span class="nav-text">Home</span>
                </NavLink>
            </div>
        </div>

        <div class="nav-group">
            <div class="nav-group-label">BIN data</div>

            @* A link is only shown to someone whose role can actually follow it. The route
               itself is guarded too, so hiding it is presentation, not the control. *@
            <AuthorizeView Policy="@Permissions.BinClassify">
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="lookup" title="BIN Lookup">
                            <span class="ico ico-lookup nav-icon" aria-hidden="true"></span>
                            <span class="nav-text">BIN Lookup</span>
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="bin-ranges" title="BIN Ranges">
                            <span class="ico ico-ranges nav-icon" aria-hidden="true"></span>
                            <span class="nav-text">BIN Ranges</span>
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="@Permissions.BinRangesRead">
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="scheme-mismatches" title="Scheme mismatches">
                            <span class="ico ico-warning nav-icon" aria-hidden="true"></span>
                            <span class="nav-text">Scheme mismatches</span>
                            @if (_mismatchCount > 0)
                            {
                                <span class="nav-badge"
                                      title="@_mismatchCount ranges contradict the detected scheme">
                                    @(_mismatchCount > 99 ? "99+" : _mismatchCount.ToString())
                                </span>
                            }
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <AuthorizeView Policy="@Permissions.BinRangesImport">
            <Authorized>
                <div class="nav-group">
                    <div class="nav-group-label">Import</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="import" title="Import CSV">
                            <span class="ico ico-import nav-icon" aria-hidden="true"></span>
                            <span class="nav-text">Import CSV</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="import-history" title="Import History">
                            <span class="ico ico-history nav-icon" aria-hidden="true"></span>
                            <span class="nav-text">Import History</span>
                        </NavLink>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-group">
            <div class="nav-group-label">Configuration</div>

            <AuthorizeView Policy="@Permissions.CommissionRulesRead">
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="commission-rules" title="Commission Rules">
                            <span class="ico ico-commission nav-icon" aria-hidden="true"></span>
                            <span class="nav-text">Commission Rules</span>
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="@Permissions.ReferenceDataManage">
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="reference-data" title="Reference Data">
                            <span class="ico ico-reference nav-icon" aria-hidden="true"></span>
                            <span class="nav-text">Reference Data</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="currencies" title="Currencies">
                            <span class="ico ico-currency nav-icon" aria-hidden="true"></span>
                            <span class="nav-text">Currencies</span>
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="nav-group">
            <div class="nav-group-label">Administration</div>

            <AuthorizeView Policy="@Permissions.AuditRead">
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="audit" title="Audit Log">
                            <span class="ico ico-audit nav-icon" aria-hidden="true"></span>
                            <span class="nav-text">Audit Log</span>
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="@Permissions.RolesManage">
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="access-control" title="Access Control">
                            <span class="ico ico-access nav-icon" aria-hidden="true"></span>
                            <span class="nav-text">Access Control</span>
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

@*
    A plain <label> rather than a button, so the sidebar collapses with no
    interactivity: the checkbox it drives lives in MainLayout, where it can size
    the sidebar element itself.
*@
<label class="nav-collapse-btn" for="nav-collapse">
    <span class="ico ico-chevron-left nav-collapse-icon" aria-hidden="true"></span>
    <span class="nav-text">Collapse</span>
</label>

@code {
    private int _mismatchCount;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [Inject]
    private BinRangeApiClient Api { get; set; } = default!;

    [Inject]
    private IAuthorizationService Authorization { get; set; } = default!;

    // The badge is a decoration on a link the user can already see, so a failed count is
    // dropped rather than surfaced: a nav that throws would take every page down with it.
    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null) return;

        var state = await AuthenticationState;
        if (state.User.Identity is not { IsAuthenticated: true }) return;

        var canRead = (await Authorization.AuthorizeAsync(
            state.User, Permissions.BinRangesRead)).Succeeded;
        if (!canRead) return;

        try
        {
            _mismatchCount = await Api.CountSchemeMismatchesAsync();
        }
        catch (Exception)
        {
            _mismatchCount = 0;
        }
    }
}
