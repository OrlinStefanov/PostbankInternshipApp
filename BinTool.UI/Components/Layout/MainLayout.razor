@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

<div class="page">
    <input type="checkbox" id="nav-collapse" class="nav-collapse" aria-label="Collapse navigation" />

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <h1 class="page-name">@PageName()</h1>

            <div class="top-row-end">
                <button type="button" class="theme-toggle" onclick="BinToolTheme.toggle()"
                        title="Switch between the light and dark theme"
                        aria-label="Switch between the light and dark theme">
                    <span class="ico ico-moon theme-to-dark" aria-hidden="true"></span>
                    <span class="ico ico-sun theme-to-light" aria-hidden="true"></span>
                </button>

                <AuthorizeView>
                    <Authorized>
                        <span class="user-chip">
                            <span class="user-avatar" aria-hidden="true">@Initials(context.User)</span>
                            <span class="user-lines">
                                <span class="user-name">@DisplayName(context.User)</span>
                                <span class="user-roles">@Roles(context.User)</span>
                            </span>
                        </span>
                        <a class="btn btn-outline-secondary btn-sm" href="logout">Sign out</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-primary btn-sm" href="login">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized() =>
        Nav.LocationChanged += OnLocationChanged;

    public void Dispose() =>
        Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private static readonly Dictionary<string, string> PageNames = new(StringComparer.OrdinalIgnoreCase)
    {
        [""] = "Home",
        ["lookup"] = "BIN Lookup",
        ["bin-ranges"] = "BIN Ranges",
        ["scheme-mismatches"] = "Scheme Mismatches",
        ["import"] = "Import CSV",
        ["import-history"] = "Import History",
        ["commission-rules"] = "Commission Rules",
        ["reference-data"] = "Reference Data",
        ["currencies"] = "Currencies",
        ["audit"] = "Audit Log",
        ["access-control"] = "Access Control",
        ["logout"] = "Sign out",
        ["access-denied"] = "Access denied"
    };

    private string PageName()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);

        var cut = path.IndexOfAny(new[] { '?', '#' });
        if (cut >= 0) path = path[..cut];

        return PageNames.TryGetValue(path.Trim('/'), out var name) ? name : "BinTool";
    }

    private static string DisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        var fullName = user.FindFirst("full_name")?.Value;
        return string.IsNullOrWhiteSpace(fullName) ? user.Identity?.Name ?? "Signed in" : fullName;
    }

    private static string Roles(System.Security.Claims.ClaimsPrincipal user) =>
        string.Join(", ", user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value));

    private static string Initials(System.Security.Claims.ClaimsPrincipal user)
    {
        var letters = DisplayName(user)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(part => char.IsLetter(part[0]))
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0]));

        var initials = string.Concat(letters);

        return initials.Length == 0 ? "•" : initials;
    }
}
