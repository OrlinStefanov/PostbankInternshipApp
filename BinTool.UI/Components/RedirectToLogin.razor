@inject NavigationManager Nav

@*
    Splits the two reasons a page can be refused:
    - nobody is signed in, so send them to log in and come back here afterwards;
    - somebody is signed in but lacks the role, which no amount of logging in fixes,
      so say so plainly rather than looping them through the login form.
*@

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var signedIn = AuthenticationState is not null
            && (await AuthenticationState).User.Identity?.IsAuthenticated == true;

        if (signedIn)
        {
            Nav.NavigateTo("access-denied", replace: true);
            return;
        }

        var returnUrl = Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo($"login?returnUrl={Uri.EscapeDataString("/" + returnUrl)}", replace: true);
    }
}
