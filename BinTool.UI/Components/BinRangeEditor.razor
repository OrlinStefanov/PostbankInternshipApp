@inject BinRangeApiClient Api

@* Rendered only while open, so the surrounding page owns "is the dialog up?" and this
   component owns everything inside it. *@
<div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-label="@Title">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <EditForm Model="_input" OnValidSubmit="Save" FormName="bin-range-editor">
                <DataAnnotationsValidator />

                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" aria-label="Close"
                            @onclick="Cancel" disabled="@_saving"></button>
                </div>

                <div class="modal-body">
                    @if (_error is not null)
                    {
                        <div class="alert alert-danger" role="alert">@_error</div>
                    }

                    @if (_mismatch is not null)
                    {
                        <div class="alert alert-warning d-flex flex-column gap-2" role="alert">
                            <div>
                                <strong>The prefix does not match the card scheme.</strong>
                                <div class="small mt-1">@_mismatch</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="DismissMismatch" disabled="@_saving">
                                    Change the scheme
                                </button>
                                <button type="button" class="btn btn-sm btn-warning"
                                        @onclick="SaveAnyway" disabled="@_saving">
                                    Save anyway
                                </button>
                            </div>
                        </div>
                    }

                    <div class="row g-4">
                    <div class="col-12 col-lg-7">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="e-prefix">Prefix</label>
                            @* Plain input rather than InputText so oninput fires on every
                               keystroke - the scheme hint follows the current digits rather
                               than waiting for blur. *@
                            <input id="e-prefix" type="text" class="form-control mono" inputmode="numeric"
                                   placeholder="6 to 8 digits" value="@_input.Prefix"
                                   @oninput="OnPrefixInput" />
                            <ValidationMessage For="() => _input.Prefix" class="form-text text-danger" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="e-scheme">Card scheme</label>
                            <InputSelect id="e-scheme" class="@SchemeSelectCssClass"
                                         @bind-Value="_input.CardScheme"
                                         @bind-Value:after="RefreshHintAsync">
                                <option value="">Choose…</option>
                                @foreach (var name in Options.CardSchemes)
                                {
                                    <option value="@name">@name</option>
                                }
                            </InputSelect>
                            @if (DetectedScheme is not null)
                            {
                                if (_hint!.MatchesDeclared)
                                {
                                    <div class="form-text text-success">
                                        Matches the prefix (@DetectedScheme).
                                    </div>
                                }
                                else if (string.IsNullOrWhiteSpace(_input.CardScheme))
                                {
                                    <div class="form-text">
                                        Prefix looks like <strong>@DetectedScheme</strong>.
                                    </div>
                                }
                                else
                                {
                                    <div class="form-text text-warning-emphasis">
                                        Prefix looks like <strong>@DetectedScheme</strong>, not
                                        @_input.CardScheme.
                                    </div>
                                }
                            }
                            else if (_hintRequested)
                            {
                                <div class="form-text text-warning-emphasis">
                                    Prefix does not sit in any known card-scheme range.
                                </div>
                            }
                            <ValidationMessage For="() => _input.CardScheme" class="form-text text-danger" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="e-product">Product type</label>
                            <InputSelect id="e-product" class="form-select" @bind-Value="_input.ProductType">
                                <option value="">Choose…</option>
                                @foreach (var name in Options.ProductTypes)
                                {
                                    <option value="@name">@name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _input.ProductType" class="form-text text-danger" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="e-funding">Funding type</label>
                            <InputSelect id="e-funding" class="form-select" @bind-Value="_input.FundingType">
                                <option value="">Choose…</option>
                                @foreach (var name in Options.FundingTypes)
                                {
                                    <option value="@name">@name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _input.FundingType" class="form-text text-danger" />
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="e-country">Issuing country</label>
                            <InputSelect id="e-country" class="form-select" @bind-Value="_input.CountryCode">
                                <option value="">Choose…</option>
                                @foreach (var country in Options.Countries)
                                {
                                    <option value="@country.IsoCode">@country.IsoCode — @country.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _input.CountryCode" class="form-text text-danger" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="e-from">Valid from</label>
                            <InputDate id="e-from" class="form-control" @bind-Value="_input.ValidFrom" />
                            <ValidationMessage For="() => _input.ValidFrom" class="form-text text-danger" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="e-to">Valid to</label>
                            <InputDate id="e-to" class="form-control" @bind-Value="_input.ValidTo" />
                            <div class="form-text">Leave empty for an open-ended range.</div>
                            <ValidationMessage For="() => _input.ValidTo" class="form-text text-danger" />
                        </div>
                    </div>

                    @if (Range is null)
                    {
                        <p class="text-danger small mb-0 mt-3">
                            Only the reference data already in the database can be chosen. If a
                            scheme or country is missing, it has to be added there first.
                        </p>
                    }
                    </div>

                    @* The preview follows the form in the DOM so a narrow screen puts the
                       fields first; on a wide one it sits beside them. Nothing here is an
                       input - it is the form's own values played back, drawn as the card
                       they describe and listed underneath as text, so a mistyped digit or
                       a scheme left on its previous value is visible before saving. *@
                    <div class="col-12 col-lg-5">
                        <div class="editor-preview">
                            <div class="editor-preview-head">Preview</div>

                            <BinCard Kind="BIN range"
                                     Scheme="@_input.CardScheme"
                                     StatusLabel="@PreviewStatus"
                                     StatusTone="@PreviewStatusTone"
                                     Prefix="@_input.Prefix"
                                     NumberNote="@PreviewNote"
                                     ValidFrom="@(_input.ValidFrom == default ? null : _input.ValidFrom)"
                                     ValidTo="_input.ValidTo"
                                     CountryCode="@_input.CountryCode"
                                     CountryName="@PreviewCountryName"
                                     Region="@PreviewRegion"
                                     ProductType="@_input.ProductType"
                                     FundingType="@_input.FundingType"
                                     Hint="Drag to turn" />

                            <dl class="detail-list mt-3">
                                <dt>Prefix</dt>
                                <dd>@Shown(_input.Prefix)</dd>

                                <dt>Scheme</dt>
                                <dd>@Shown(_input.CardScheme)</dd>

                                <dt>Product</dt>
                                <dd>@Shown(_input.ProductType)</dd>

                                <dt>Funding</dt>
                                <dd>@Shown(_input.FundingType)</dd>

                                <dt>Country</dt>
                                <dd>
                                    @(string.IsNullOrWhiteSpace(_input.CountryCode)
                                        ? Unset
                                        : $"{_input.CountryCode} — {PreviewCountryName}")
                                </dd>

                                <dt>Valid from</dt>
                                <dd>@(_input.ValidFrom == default ? Unset : Date(_input.ValidFrom))</dd>

                                <dt>Valid to</dt>
                                <dd>@(_input.ValidTo is null ? "Open-ended" : Date(_input.ValidTo.Value))</dd>
                            </dl>
                        </div>
                    </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="Cancel" disabled="@_saving">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        @(Range is null ? "Add range" : "Save changes")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>
<div class="modal-backdrop show"></div>

@code {
    [Parameter, EditorRequired]
    public BinRangeFilterOptions Options { get; set; } = new();

    [Parameter]
    public BinRangeListItem? Range { get; set; }

    [Parameter]
    public EventCallback<BinRangeMutationResult> OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private BinRangeInput _input = new();
    private bool _saving;
    private string? _error;
    private string? _mismatch;

    // The reading comes from the server - the detector is a business rule, and running a copy here
    // would mean two places to keep in step. _autoSuggested holds the name the code last wrote into
    // the scheme select, so a later reading can update it without overwriting a deliberate choice.
    private SchemeHint? _hint;
    private bool _hintRequested;
    private string? _autoSuggested;

    // Detection is a pure function of (prefix, declared scheme), so an answer never goes stale.
    // Typing out an 8-digit prefix costs three calls and going back over it costs none.
    private readonly Dictionary<(string Prefix, string? Declared), SchemeHint> _hints = new();

    // Keystrokes outrun round-trips, so an older reading must not land on top of a newer one.
    private CancellationTokenSource? _hintRequest;

    // Shortest prefix worth asking about; typing the first few digits costs nothing. Taken from
    // the domain constant so the two cannot drift apart.
    private const int MinPrefixLength = BinPrefix.MinLength;

    private string? DetectedScheme => _hint?.DetectedScheme;

    private string SchemeSelectCssClass
    {
        get
        {
            const string basic = "form-select";
            if (_hint?.DetectedScheme is null) return basic;
            if (_hint.MatchesDeclared) return $"{basic} is-valid";
            if (string.IsNullOrWhiteSpace(_input.CardScheme)) return basic;
            return $"{basic} is-invalid";
        }
    }

    private string Title => Range is null ? "Add BIN range" : $"Edit BIN range {Range.Prefix}";

    // ---- Live preview ----------------------------------------------------------
    //
    // Every member here reads off _input, so the card and the list beside the form follow the
    // fields without anything having to push them.

    private const string Unset = "—";

    private string PreviewCountryName =>
        Options.Countries
            .FirstOrDefault(c => string.Equals(c.IsoCode, _input.CountryCode, StringComparison.OrdinalIgnoreCase))
            ?.Name ?? string.Empty;

    // The region is not part of the country list the editor loads, only of a range that was
    // fetched. So it can be shown while the country is still the one the range came with, and is
    // blanked as soon as the country changes rather than showing the old one's.
    private string? PreviewRegion =>
        Range is not null && string.Equals(Range.CountryCode, _input.CountryCode, StringComparison.OrdinalIgnoreCase)
            ? Range.Region
            : null;

    private string PreviewNote
    {
        get
        {
            var digits = (_input.Prefix ?? string.Empty).Count(char.IsDigit);

            return digits == 0
                ? "No prefix yet"
                : $"{digits}-digit prefix — the rest is any card in the range";
        }
    }

    // What the range's status would be if it were saved as the form currently stands. The server
    // works this out from the dates too, so this is a preview of a real outcome and not a second
    // opinion about one.
    private BinRangeStatus PreviewState
    {
        get
        {
            var today = DateTime.UtcNow.Date;

            if (_input.ValidFrom != default && _input.ValidFrom > today) return BinRangeStatus.Scheduled;
            if (_input.ValidTo is not null && _input.ValidTo < today) return BinRangeStatus.Expired;

            return BinRangeStatus.Active;
        }
    }

    private string PreviewStatus => PreviewState.ToString();

    private string PreviewStatusTone => PreviewState switch
    {
        BinRangeStatus.Active => "success",
        BinRangeStatus.Scheduled => "info",
        BinRangeStatus.Expired => "warning",
        _ => "secondary"
    };

    private static string Date(DateTime value) => value.ToString("yyyy-MM-dd");

    private static string Shown(string? value) => string.IsNullOrWhiteSpace(value) ? Unset : value;

    protected override async Task OnParametersSetAsync()
    {
        _input = Range is null
            ? new BinRangeInput { ValidFrom = DateTime.UtcNow.Date }
            : new BinRangeInput
            {
                Prefix = Range.Prefix,
                CardScheme = Range.CardScheme,
                ProductType = Range.ProductType,
                FundingType = Range.FundingType,
                CountryCode = Range.CountryCode,
                ValidFrom = Range.ValidFrom,
                ValidTo = Range.ValidTo
            };

        _error = null;
        _mismatch = null;
        _autoSuggested = null;
        await RefreshHintAsync();
    }

    // Reflects each keystroke back onto the model and refreshes the hint, so it updates while the
    // user is still typing rather than after the field loses focus.
    private async Task OnPrefixInput(ChangeEventArgs e)
    {
        _input.Prefix = e.Value?.ToString() ?? string.Empty;
        await RefreshHintAsync();
    }

    // Asks the server what it makes of the current prefix. Runs twice at most: pre-filling the
    // scheme select changes what "does it agree?" is being asked about, so the answer has to be
    // asked again - the second pass finds nothing left to suggest and stops.
    private async Task RefreshHintAsync()
    {
        for (var pass = 0; pass < 2; pass++)
        {
            var before = _input.CardScheme;

            if (!await LoadHintAsync()) return;

            AutoSuggestScheme();

            if (string.Equals(_input.CardScheme, before, StringComparison.Ordinal)) return;
        }
    }

    // False when there is nothing to ask about, or the answer never arrived. The hint is a
    // convenience - the server checks the scheme again on save - so a failed call leaves the field
    // unannotated rather than blocking the form.
    private async Task<bool> LoadHintAsync()
    {
        var prefix = (_input.Prefix ?? string.Empty).Trim();

        // Below the shortest storable prefix there is nothing to detect, and a stray character is
        // the prefix field's own validation message to give rather than this one's.
        if (prefix.Length < MinPrefixLength || !prefix.All(char.IsAsciiDigit))
        {
            _hint = null;
            _hintRequested = false;
            return false;
        }

        var key = (prefix, _input.CardScheme);

        if (_hints.TryGetValue(key, out var cached))
        {
            _hint = cached;
            _hintRequested = true;
            return true;
        }

        _hintRequest?.Cancel();
        _hintRequest = new CancellationTokenSource();

        try
        {
            var hint = await Api.GetSchemeHintAsync(prefix, _input.CardScheme, _hintRequest.Token);

            _hints[key] = hint;
            _hint = hint;
            _hintRequested = true;
            return true;
        }
        catch (OperationCanceledException)
        {
            // A later keystroke owns the hint now; leave whatever it settles on in place.
            return false;
        }
        catch
        {
            _hint = null;
            _hintRequested = false;
            return false;
        }
    }

    // Pre-fills the scheme select when it would otherwise be empty or still holds a previous
    // suggestion. Never overwrites a value the user chose themselves - if they picked "Visa" for a
    // Mastercard prefix, the select stays on Visa and the hint calls out the disagreement.
    private void AutoSuggestScheme()
    {
        if (DetectedScheme is null)
            return;

        // Only auto-fill with a name that exists as reference data - a scheme the admin
        // hasn't added yet would fail validation on the select.
        if (!Options.CardSchemes.Contains(DetectedScheme))
            return;

        var currentIsEmpty = string.IsNullOrWhiteSpace(_input.CardScheme);
        var currentIsPreviousSuggestion = _autoSuggested is not null &&
            string.Equals(_input.CardScheme, _autoSuggested, StringComparison.Ordinal);

        if (currentIsEmpty || currentIsPreviousSuggestion)
        {
            _input.CardScheme = DetectedScheme;
            _autoSuggested = DetectedScheme;
        }
    }

    // Submits the form. Clears the acknowledgement flag first so a warning shown on the previous
    // attempt cannot silently carry over into a fresh save - the user has to click SaveAnyway for
    // that to happen.
    private Task Save()
    {
        _input.AcknowledgeSchemeMismatch = false;
        return SendAsync();
    }

    // Second attempt after a scheme mismatch warning: the user has looked at the message and chosen
    // to keep the row as declared. The API records the acknowledgement in the same call, so nothing
    // else has to remember it.
    private Task SaveAnyway()
    {
        _input.AcknowledgeSchemeMismatch = true;
        return SendAsync();
    }

    private void DismissMismatch()
    {
        _mismatch = null;
        _input.AcknowledgeSchemeMismatch = false;
    }

    private async Task SendAsync()
    {
        _saving = true;
        _error = null;
        _mismatch = null;

        try
        {
            var result = Range is null
                ? await Api.CreateAsync(_input)
                : await Api.UpdateAsync(Range.BinRangeId, _input);

            if (result.Status == BinRangeMutationStatus.SchemeMismatch)
            {
                // A soft refusal: the row is fine, the detector just disagrees with the
                // scheme choice. Show the reason and let the user decide.
                _mismatch = result.Error;
                return;
            }

            if (!result.Succeeded)
            {
                // A hard refusal - a taken prefix, a name that does not exist - belongs
                // next to the form the user is still filling in, not on the page behind.
                _error = result.Error;
                return;
            }

            await OnSaved.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            _error = $"Could not save the range: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Cancel()
    {
        if (_saving) return;

        await OnCancel.InvokeAsync();
    }
}
