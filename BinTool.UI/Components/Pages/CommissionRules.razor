@page "/commission-rules"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.CommissionRulesRead)]
@using System.Globalization
@using BinTool.Core.Models.Commission
@using BinTool.Core.Models.Currency
@using BinTool.Core.Models.ReferenceData
@inject CommissionRuleApiClient Api
@inject ReferenceDataApiClient LookupApi
@inject CurrencyApiClient CurrencyApi

<PageTitle>Commission rules</PageTitle>

<div class="page-head d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1 class="h3 mb-1">Commission rules</h1>
        <p class="text-secondary mb-0">
            The pricing a lookup applies to a transaction amount. A rule is a percentage plus a
            fixed amount with a minimum fee, keyed on a scheme, product, funding and region
            where any field may be a wildcard. The most specific rule that matches a card wins.
        </p>
    </div>
    <div>
        <AuthorizeView Policy="@Permissions.CommissionRulesWrite" Context="write">
            <Authorized>
                <button class="btn btn-primary" @onclick="StartAdd" disabled="@_busy">Add rule</button>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<div class="filters card mt-4">
    <div class="card-body py-2 d-flex flex-wrap align-items-center gap-3">
        <div class="form-check mb-0">
            <input id="f-expired" class="form-check-input" type="checkbox"
                   checked="@_includeExpired" @onchange="OnIncludeExpiredChanged" />
            <label class="form-check-label" for="f-expired">Include expired</label>
        </div>
        <div class="form-check mb-0">
            <input id="f-deleted" class="form-check-input" type="checkbox"
                   checked="@_includeDeleted" @onchange="OnIncludeDeletedChanged" />
            <label class="form-check-label" for="f-deleted">Include deleted</label>
        </div>

        <span class="text-secondary small ms-auto">
            @if (_loading)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Loading…</span>
            }
            else
            {
                <span>@_rules.Count @(_rules.Count == 1 ? "rule" : "rules")</span>
            }
        </span>
    </div>
</div>

@* The fallback default: applied when a classified card matches no rule. Shown up front
   because it is the one rule that changes what an unmatched lookup returns. *@
<div class="card mt-3">
    <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
        <span class="fw-semibold me-1">Fallback default</span>
        @if (_default is not null)
        {
            <span class="badge rounded-pill text-bg-primary">@_default.RuleName</span>
            <span class="text-secondary small">
                applied when no rule matches — @Rate(_default)
            </span>
            @if (_canWrite)
            {
                <button class="btn btn-outline-secondary btn-sm ms-auto"
                        @onclick="ClearDefault" disabled="@_busy">Clear default</button>
            }
        }
        else
        {
            <span class="text-secondary small">
                None set. An unmatched lookup returns no commission. Set a default from the
                <strong>Default</strong> action on any active rule below.
            </span>
        }
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger mt-3" role="alert">@_error</div>
}

@if (_notice is not null)
{
    <div class="alert alert-success alert-dismissible mt-3" role="alert">
        @_notice
        <button type="button" class="btn-close" aria-label="Dismiss"
                @onclick="() => _notice = null"></button>
    </div>
}

@if (!_loading && _rules.Count == 0 && _error is null)
{
    <div class="card empty-state mt-3">
        <div class="card-body text-center py-5">
            <p class="mb-1 fw-semibold">Nothing to show</p>
            <p class="text-secondary mb-3">
                @if (_includeDeleted || _includeExpired)
                {
                    <span>No commission rules match these filters.</span>
                }
                else
                {
                    <span>No commission rules have been added yet.</span>
                }
            </p>
            <AuthorizeView Policy="@Permissions.CommissionRulesWrite" Context="write">
                <Authorized>
                    <button class="btn btn-primary btn-sm" @onclick="StartAdd">Add the first rule</button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
}
else if (!_loading)
{
    <div class="card mt-3">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Rule</th>
                        <th>Scheme</th>
                        <th>Product</th>
                        <th>Funding</th>
                        <th>Region</th>
                        <th>Ccy</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Fixed</th>
                        <th class="text-end">Min</th>
                        <th>Valid</th>
                        <th>Status</th>
                        <th class="pe-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _rules)
                    {
                        <tr class="@(item.Status == CommissionRuleStatus.Deleted ? "row-muted" : null)">
                            <td class="ps-3">
                                <span class="fw-semibold">@item.RuleName</span>
                                @if (item.IsDefault)
                                {
                                    <span class="badge rounded-pill text-bg-primary ms-1">Default</span>
                                }
                                <span class="text-secondary small d-block">Specificity @item.Specificity/4</span>
                            </td>
                            <td>@Wild(item.CardSchemeName)</td>
                            <td>@Wild(item.ProductTypeName)</td>
                            <td>@Wild(item.FundingTypeName)</td>
                            <td>@Wild(item.RegionName)</td>
                            <td class="mono">@item.CurrencyCode</td>
                            <td class="text-end mono">@Num(item.PercentageRate)%</td>
                            <td class="text-end mono">@Num(item.FixedAmount)</td>
                            <td class="text-end mono">@Num(item.MinimumFee)</td>
                            <td class="text-nowrap">
                                @Date(item.ValidFrom)
                                <span class="text-secondary small d-block">
                                    to @(item.ValidTo is null ? OpenEnded : Date(item.ValidTo.Value))
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill text-bg-@StatusColor(item.Status)">
                                    @item.Status
                                </span>
                            </td>
                            <td class="pe-3 text-end text-nowrap">
                                @if (_canWrite)
                                {
                                    @if (item.Status == CommissionRuleStatus.Deleted)
                                    {
                                        <button class="btn btn-outline-success btn-sm"
                                                @onclick="() => Restore(item)" disabled="@_busy">
                                            Restore
                                        </button>
                                    }
                                    else
                                    {
                                        @if (!item.IsDefault && item.Status == CommissionRuleStatus.Active)
                                        {
                                            <button class="btn btn-outline-primary btn-sm me-1"
                                                    @onclick="() => SetDefault(item)" disabled="@_busy"
                                                    title="Make this the fallback default">
                                                Default
                                            </button>
                                        }
                                        <button class="btn btn-outline-primary btn-sm me-1"
                                                @onclick="() => StartEdit(item)" disabled="@_busy">
                                            Edit
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => _pendingDelete = item" disabled="@_busy">
                                            Delete
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="text-secondary small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_editorOpen)
{
    <CommissionRuleEditor Schemes="_schemes" Products="_products" FundingTypes="_fundingTypes"
                          Regions="_regions" Currencies="_currencies" Rule="_editing"
                          OnSaved="OnSaved" OnCancel="CloseEditor" />
}

@if (_pendingDelete is not null)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-label="Confirm delete">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete rule '@_pendingDelete.RuleName'?</h5>
                    <button type="button" class="btn-close" aria-label="Close"
                            @onclick="() => _pendingDelete = null" disabled="@_busy"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        The rule stops taking part in resolution and drops out of this listing.
                    </p>
                    <p class="text-secondary small mb-0">
                        Nothing is erased. Toggle <strong>Include deleted</strong> to find it again
                        and restore it. A rule that is the current default cannot be deleted -
                        clear or reassign the default first.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="() => _pendingDelete = null" disabled="@_busy">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        Delete rule
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private const string OpenEnded = "—";

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _notice;

    private bool _includeDeleted;
    private bool _includeExpired;

    private List<CommissionRuleListItem> _rules = new();
    private CommissionRuleListItem? _default;

    // Reference lists for the editor's wildcard dropdowns, loaded once.
    private List<LookupListItem> _schemes = new();
    private List<LookupListItem> _products = new();
    private List<LookupListItem> _fundingTypes = new();
    private List<LookupListItem> _regions = new();
    private List<CurrencyListItem> _currencies = new();

    private bool _canWrite;
    private bool _editorOpen;
    private CommissionRuleListItem? _editing;
    private CommissionRuleListItem? _pendingDelete;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [Inject]
    private IAuthorizationService Authorization { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            var state = await AuthenticationState;
            _canWrite = (await Authorization.AuthorizeAsync(
                state.User, Permissions.CommissionRulesWrite)).Succeeded;
        }

        // The editor's dropdowns only ever offer live reference values; a scheme that was
        // retired should not be pickable for a new rule.
        try
        {
            _schemes = await LookupApi.SearchAsync(LookupKind.CardScheme, includeDeleted: false);
            _products = await LookupApi.SearchAsync(LookupKind.ProductType, includeDeleted: false);
            _fundingTypes = await LookupApi.SearchAsync(LookupKind.FundingType, includeDeleted: false);
            _regions = await LookupApi.SearchAsync(LookupKind.Region, includeDeleted: false);
            _currencies = (await CurrencyApi.SearchAsync(includeDeleted: false))
                .Where(c => c.IsActive).ToList();
        }
        catch (Exception ex)
        {
            // A failed reference load still leaves the listing worth showing; only the editor
            // dropdowns would be empty.
            _error = $"Could not load reference data: {ex.Message}";
        }

        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        try
        {
            _rules = await Api.SearchAsync(_includeDeleted, _includeExpired);
            _default = _rules.FirstOrDefault(r => r.IsDefault);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Could not load commission rules: {ex.Message}";
            _rules = new();
            _default = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnIncludeExpiredChanged(ChangeEventArgs e)
    {
        _includeExpired = e.Value is true;
        await Load();
    }

    private async Task OnIncludeDeletedChanged(ChangeEventArgs e)
    {
        _includeDeleted = e.Value is true;
        await Load();
    }

    // ---- Editor ----------------------------------------------------------------

    private void StartAdd()
    {
        _editing = null;
        _notice = null;
        _editorOpen = true;
    }

    private void StartEdit(CommissionRuleListItem item)
    {
        _editing = item;
        _notice = null;
        _editorOpen = true;
    }

    private void CloseEditor()
    {
        _editorOpen = false;
        _editing = null;
    }

    /// <summary>
    /// Reloads rather than patching the row in place: a change can move a rule between the
    /// active, scheduled and expired buckets, and a listing that disagrees with the database
    /// is worse than an extra call.
    /// </summary>
    private async Task OnSaved(CommissionRuleMutationResult result)
    {
        CloseEditor();

        var rule = result.Rule!;
        _notice = result.Status switch
        {
            CommissionRuleMutationStatus.Created => $"Added commission rule '{rule.RuleName}'.",
            CommissionRuleMutationStatus.Updated => $"Saved commission rule '{rule.RuleName}'.",
            _ => $"Commission rule '{rule.RuleName}' saved."
        };

        await Load();
    }

    // ---- Row actions -----------------------------------------------------------

    private async Task ConfirmDelete()
    {
        var item = _pendingDelete;
        if (item is null) return;

        await Run(() => Api.DeleteAsync(item.Id), $"Deleted rule '{item.RuleName}'. Toggle 'Include deleted' to restore it.");

        _pendingDelete = null;
    }

    private Task Restore(CommissionRuleListItem item) =>
        Run(() => Api.RestoreAsync(item.Id), $"Restored rule '{item.RuleName}'.");

    private Task SetDefault(CommissionRuleListItem item) =>
        Run(() => Api.SetDefaultAsync(item.Id), $"'{item.RuleName}' is now the fallback default.");

    private Task ClearDefault() =>
        Run(() => Api.ClearDefaultAsync(), "Cleared the fallback default. An unmatched lookup now returns no commission.");

    /// <summary>
    /// Runs one write, reports it, and reloads. Refusals arrive as an ordinary result, so
    /// only a transport failure reaches the catch.
    /// </summary>
    private async Task Run(Func<Task<CommissionRuleMutationResult>> action, string success)
    {
        _busy = true;
        _notice = null;

        try
        {
            var result = await action();

            if (!result.Succeeded)
            {
                _error = result.ConflictingRuleName is null
                    ? result.Error
                    : $"{result.Error} (conflicts with '{result.ConflictingRuleName}')";
                return;
            }

            _notice = success;
            _error = null;
            await Load();
        }
        catch (Exception ex)
        {
            _error = $"The change could not be applied: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    // ---- Formatting ------------------------------------------------------------

    private static string Wild(string? name) => string.IsNullOrEmpty(name) ? "Any" : name;

    private static string Date(DateTime value) => value.ToString("yyyy-MM-dd");

    /// <summary>
    /// Money and rates are shown with a dot decimal separator regardless of the server's
    /// locale, so the listing matches what the editor accepts and what the API returns.
    /// </summary>
    private static string Num(decimal value) => value.ToString("0.####", CultureInfo.InvariantCulture);

    private static string Rate(CommissionRuleListItem rule) =>
        $"{Num(rule.PercentageRate)}% + {Num(rule.FixedAmount)} {rule.CurrencyCode}, min {Num(rule.MinimumFee)} {rule.CurrencyCode}";

    private static string StatusColor(CommissionRuleStatus status) => status switch
    {
        CommissionRuleStatus.Active => "success",
        CommissionRuleStatus.Scheduled => "info",
        CommissionRuleStatus.Expired => "warning",
        CommissionRuleStatus.Inactive => "secondary",
        CommissionRuleStatus.Deleted => "secondary",
        _ => "secondary"
    };
}
