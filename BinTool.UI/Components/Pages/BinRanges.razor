@page "/bin-ranges"
@rendermode InteractiveServer
@attribute [Authorize]
@inject BinRangeApiClient Api

<PageTitle>BIN Ranges</PageTitle>

<p class="page-lead">
    Everything currently stored. Filter to find a prefix, and check its status
    before assuming classification will match it.
</p>

@if (_error is not null)
{
    <div class="alert alert-danger mb-3" role="alert">@_error</div>
}

@if (_notice is not null)
{
    <div class="alert alert-success alert-dismissible mb-3" role="alert">
        @_notice
        <button type="button" class="btn-close" aria-label="Dismiss"
                @onclick="() => _notice = null"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <div class="card-header-main">
            <span>BIN Ranges</span>
            @if (_loading)
            {
                <span class="spinner-border spinner-border-sm text-secondary"
                      role="status" aria-hidden="true"></span>
            }
            else
            {
                <span class="count-pill">@_page.TotalCount</span>
            }
        </div>
        <div class="card-actions">
            <AuthorizeView Policy="@Permissions.BinRangesImport" Context="import">
                <Authorized>
                    <a class="btn btn-outline-primary btn-sm" href="import">Import CSV</a>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Permissions.BinRangesWrite" Context="write">
                <Authorized>
                    <button class="btn btn-primary btn-sm" @onclick="StartAdd">Add range</button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @* Each filter carries its name in the placeholder or in its "any" option rather
       than in a label - that is what keeps the strip to a single row. `aria-label`
       says the same thing to a screen reader, which a placeholder alone would not. *@
    <div class="filter-bar">
        <input class="form-control mono" style="width: 150px" inputmode="numeric"
               aria-label="Prefix starts with" placeholder="Prefix starts with…"
               value="@_prefix" @oninput="OnPrefixInput" @onkeydown="OnPrefixKeyDown" />

        <select class="form-select" aria-label="Card scheme" value="@_cardScheme"
                @onchange="e => ApplyFilter(v => _cardScheme = v, e)">
            <option value="">All schemes</option>
            @foreach (var name in _options.CardSchemes)
            {
                <option value="@name">@name</option>
            }
        </select>

        <select class="form-select" aria-label="Product type" value="@_productType"
                @onchange="e => ApplyFilter(v => _productType = v, e)">
            <option value="">All products</option>
            @foreach (var name in _options.ProductTypes)
            {
                <option value="@name">@name</option>
            }
        </select>

        <select class="form-select" aria-label="Funding type" value="@_fundingType"
                @onchange="e => ApplyFilter(v => _fundingType = v, e)">
            <option value="">All funding</option>
            @foreach (var name in _options.FundingTypes)
            {
                <option value="@name">@name</option>
            }
        </select>

        <select class="form-select" aria-label="Issuing country" value="@_countryCode"
                @onchange="e => ApplyFilter(v => _countryCode = v, e)">
            <option value="">All countries</option>
            @foreach (var country in _options.Countries)
            {
                <option value="@country.IsoCode">@country.IsoCode — @country.Name</option>
            }
        </select>

        <select class="form-select" aria-label="Added by" value="@_createdBy"
                @onchange="e => ApplyFilter(v => _createdBy = v, e)">
            <option value="">Anyone</option>
            @foreach (var name in _options.Creators)
            {
                <option value="@name">@(IsSystem(name) ? "System" : name)</option>
            }
        </select>

        <select class="form-select" aria-label="Status" value="@_status" @onchange="OnStatusChanged">
            <option value="">Live</option>
            <option value="@nameof(BinRangeStatus.Active)">Active</option>
            <option value="@nameof(BinRangeStatus.Scheduled)">Scheduled</option>
            <option value="@nameof(BinRangeStatus.Expired)">Expired</option>
            <option value="@nameof(BinRangeStatus.Deleted)">Deleted</option>
        </select>

        @if (HasFilters)
        {
            <button class="btn btn-link btn-sm" @onclick="ClearFilters">Clear filters</button>
        }
    </div>

@if (!_loading && _page.TotalCount == 0 && _error is null)
{
    <div class="empty-state">
        <div class="empty-mark" aria-hidden="true">◇</div>
        <p class="empty-title">Nothing to show</p>
        <p class="empty-text">
            @(HasFilters
                ? "No BIN range matches these filters."
                : "No BIN ranges have been imported yet.")
        </p>
        @if (HasFilters)
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">Clear filters</button>
        }
        else
        {
            <div class="empty-actions">
                <AuthorizeView Policy="@Permissions.BinRangesImport" Context="import">
                    <Authorized>
                        <a class="btn btn-outline-primary btn-sm" href="import">Import a CSV</a>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.BinRangesWrite" Context="write">
                    <Authorized>
                        <button class="btn btn-primary btn-sm" @onclick="StartAdd">Add one by hand</button>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
    </div>
}
else
{
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 range-table">
                <thead>
                    <tr>
                        <th class="ps-3">Prefix</th>
                        <th>Scheme</th>
                        <th>Product</th>
                        <th>Funding</th>
                        <th>Country</th>
                        <th>Region</th>
                        <th>Valid from</th>
                        <th>Valid to</th>
                        <th>Added by</th>
                        <th>Status</th>
                        <th class="pe-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _page.Items)
                    {
                        <tr class="@(item.Status == BinRangeStatus.Deleted ? "row-muted" : null)">
                            <td class="ps-3">
                                <code class="mono">@item.Prefix</code>
                                <span class="text-secondary small ms-1">@item.PrefixLength</span>
                            </td>
                            <td>
                                @item.CardScheme
                                @if (item.DetectedScheme is not null)
                                {
                                    <span class="badge rounded-pill text-bg-warning ms-1"
                                          title="@($"The prefix looks like {item.DetectedScheme}, not {item.CardScheme}. Edit the row to correct it.")">
                                        ! @item.DetectedScheme
                                    </span>
                                }
                            </td>
                            <td>@item.ProductType</td>
                            <td>@item.FundingType</td>
                            <td>
                                <span class="fw-semibold">@item.CountryCode</span>
                                <span class="text-secondary small d-block">@item.CountryName</span>
                            </td>
                            <td class="text-secondary">@item.Region</td>
                            <td>@Date(item.ValidFrom)</td>
                            <td>@(item.ValidTo is null ? OpenEnded : Date(item.ValidTo.Value))</td>
                            <td title="@LastChanged(item)">
                                @if (IsSystem(item.CreatedBy))
                                {
                                    @* Not an account: nobody was signed in when this was written. *@
                                    <span class="badge rounded-pill text-bg-light">System</span>
                                }
                                else
                                {
                                    <span class="fw-semibold">@(item.CreatedBy ?? OpenEnded)</span>
                                }
                                <span class="text-secondary small d-block">@Date(item.CreatedAt)</span>
                            </td>
                            <td>
                                <span class="badge badge-status text-bg-@StatusColor(item.Status)">
                                    @item.Status
                                </span>
                            </td>
                            <td class="pe-3 text-end text-nowrap">
                                @* Each action carries its own colour - neutral to look, accent to
                                   change, green to bring back, red to withdraw - so the row can be
                                   read at a glance instead of button label by button label. *@
                                <button class="btn btn-outline-secondary btn-sm me-1"
                                        @onclick="() => View(item)" disabled="@_busy">
                                    View
                                </button>
                                @if (_canWrite)
                                {
                                    @if (item.Status == BinRangeStatus.Deleted)
                                    {
                                        <button class="btn btn-outline-success btn-sm"
                                                @onclick="() => Restore(item)" disabled="@_busy">
                                            Restore
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-primary btn-sm me-1"
                                                @onclick="() => StartEdit(item)" disabled="@_busy">
                                            Edit
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => _pendingDelete = item" disabled="@_busy">
                                            Delete
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer table-foot">
            <span class="text-secondary">
                @if (_page.TotalCount == 0)
                {
                    <span>No ranges match</span>
                }
                else
                {
                    <span>
                        @FirstOnPage–@LastOnPage of <strong class="text-body">@_page.TotalCount</strong>
                        @(_page.TotalCount == 1 ? "range" : "ranges")
                    </span>
                }
            </span>

            <div class="foot-controls">
                <label class="text-secondary" for="f-size">Per page</label>
                <select id="f-size" class="form-select form-select-sm" style="width: 75px"
                        value="@_pageSize" @onchange="OnPageSizeChanged">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>

                @if (_page.TotalPages > 1)
                {
                    <nav class="pager" aria-label="BIN range pages">
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="() => GoToPage(_page.Page - 1)"
                                disabled="@(_loading || !_page.HasPrevious)">
                            Previous
                        </button>
                        <span class="text-secondary">Page @_page.Page of @_page.TotalPages</span>
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="() => GoToPage(_page.Page + 1)"
                                disabled="@(_loading || !_page.HasNext)">
                            Next
                        </button>
                    </nav>
                }
            </div>
        </div>
}
</div>

@if (_editorOpen)
{
    <BinRangeEditor Options="_options" Range="_editing" OnSaved="OnSaved" OnCancel="CloseEditor" />
}

@if (_pendingDelete is not null)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true"
         aria-label="Confirm delete">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete BIN range @_pendingDelete.Prefix?</h5>
                    <button type="button" class="btn-close" aria-label="Close"
                            @onclick="() => _pendingDelete = null" disabled="@_busy"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        @_pendingDelete.Prefix (@_pendingDelete.CardScheme,
                        @_pendingDelete.CountryCode) will stop matching classification and
                        drop out of this listing.
                    </p>
                    <p class="text-secondary small mb-0">
                        Nothing is erased. Filter by <strong>Deleted</strong> to find it again,
                        and restore it with the values it has now.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="() => _pendingDelete = null" disabled="@_busy">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        Delete range
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@if (_viewing is not null)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true"
         aria-label="BIN range details">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        BIN range <code class="mono">@_viewing.Prefix</code>
                        <span class="badge rounded-pill text-bg-@StatusColor(_viewing.Status) ms-1">
                            @_viewing.Status
                        </span>
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close"
                            @onclick="CloseView"></button>
                </div>
                <div class="modal-body">
                    @if (_viewError is not null)
                    {
                        <div class="alert alert-danger py-2 px-3 small" role="alert">@_viewError</div>
                    }

                    @* The range is what a card carrying this prefix would be, so it is shown
                       as one - but a card is a picture, and a picture is easy to misread.
                       Every value it draws is repeated as plain text underneath. *@
                    <BinCard Kind="BIN range"
                             Scheme="@_viewing.CardScheme"
                             StatusLabel="@_viewing.Status.ToString()"
                             StatusTone="@StatusColor(_viewing.Status)"
                             Prefix="@_viewing.Prefix"
                             NumberNote="@($"{_viewing.PrefixLength}-digit prefix — the rest is any card in the range")"
                             ValidFrom="_viewing.ValidFrom"
                             ValidTo="_viewing.ValidTo"
                             CountryCode="@_viewing.CountryCode"
                             CountryName="@_viewing.CountryName"
                             Region="@_viewing.Region"
                             ProductType="@_viewing.ProductType"
                             FundingType="@_viewing.FundingType">
                        <ExtraDetails>
                            <div>
                                <dt>Added by</dt>
                                <dd>
                                    @(IsSystem(_viewing.CreatedBy) ? "System" : _viewing.CreatedBy ?? OpenEnded)
                                    <span class="bincard-when">on @Date(_viewing.CreatedAt)</span>
                                </dd>
                            </div>
                            <div>
                                <dt>Last changed by</dt>
                                <dd>
                                    @(IsSystem(_viewing.UpdatedBy) ? "System" : _viewing.UpdatedBy ?? OpenEnded)
                                    <span class="bincard-when">on @Date(_viewing.UpdatedAt)</span>
                                </dd>
                            </div>
                        </ExtraDetails>
                    </BinCard>

                    <dl class="detail-list mt-3">
                        <dt>Prefix</dt>
                        <dd><code class="mono">@_viewing.Prefix</code> <span class="text-secondary">(@_viewing.PrefixLength digits)</span></dd>

                        <dt>Scheme</dt>
                        <dd>
                            @_viewing.CardScheme
                            @if (_viewing.DetectedScheme is not null)
                            {
                                <span class="badge rounded-pill text-bg-warning ms-1"
                                      title="@($"The prefix looks like {_viewing.DetectedScheme}, not {_viewing.CardScheme}.")">
                                    ! @_viewing.DetectedScheme
                                </span>
                            }
                        </dd>

                        <dt>Product</dt>
                        <dd>@_viewing.ProductType</dd>

                        <dt>Funding</dt>
                        <dd>@_viewing.FundingType</dd>

                        <dt>Country</dt>
                        <dd>@_viewing.CountryCode — @_viewing.CountryName</dd>

                        <dt>Region</dt>
                        <dd>@_viewing.Region</dd>

                        <dt>Valid from</dt>
                        <dd>@Date(_viewing.ValidFrom)</dd>

                        <dt>Valid to</dt>
                        <dd>@(_viewing.ValidTo is null ? OpenEnded : Date(_viewing.ValidTo.Value))</dd>

                        <dt>Status</dt>
                        <dd>
                            <span class="badge badge-status text-bg-@StatusColor(_viewing.Status)">
                                @_viewing.Status
                            </span>
                        </dd>

                        <dt>Added by</dt>
                        <dd>
                            @(IsSystem(_viewing.CreatedBy) ? "System" : _viewing.CreatedBy ?? OpenEnded)
                            <span class="text-secondary">on @Date(_viewing.CreatedAt)</span>
                        </dd>

                        <dt>Last changed by</dt>
                        <dd>
                            @(IsSystem(_viewing.UpdatedBy) ? "System" : _viewing.UpdatedBy ?? OpenEnded)
                            <span class="text-secondary">on @Date(_viewing.UpdatedAt)</span>
                        </dd>
                    </dl>
                </div>
                <div class="modal-footer">
                    @if (_canWrite && _viewing.Status == BinRangeStatus.Deleted)
                    {
                        <button type="button" class="btn btn-outline-success"
                                @onclick="() => RestoreFromView(_viewing)" disabled="@_busy">
                            Restore
                        </button>
                    }
                    @* Dismissal, not an action - it should not outrank Restore beside it. *@
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseView">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private const string OpenEnded = "—";

    private bool _loading = true;
    private string? _error;
    private string? _notice;

    private BinRangeFilterOptions _options = new();
    private PagedResult<BinRangeListItem> _page = new();

    private string _prefix = string.Empty;
    private string _cardScheme = string.Empty;
    private string _productType = string.Empty;
    private string _fundingType = string.Empty;
    private string _countryCode = string.Empty;
    private string _createdBy = string.Empty;
    private string _status = string.Empty;
    private int _pageSize = BinRangeQuery.DefaultPageSize;
    private int _currentPage = 1;

    // Maintenance controls. The API enforces the permission regardless; this decides whether
    // the Edit/Delete/Restore controls are worth rendering at all.
    private bool _canWrite;
    private bool _busy;
    private bool _editorOpen;
    private BinRangeListItem? _editing;
    private BinRangeListItem? _pendingDelete;
    private BinRangeListItem? _viewing;
    private string? _viewError;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [Inject]
    private IAuthorizationService Authorization { get; set; } = default!;

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(_prefix)
        || !string.IsNullOrEmpty(_cardScheme)
        || !string.IsNullOrEmpty(_productType)
        || !string.IsNullOrEmpty(_fundingType)
        || !string.IsNullOrEmpty(_countryCode)
        || !string.IsNullOrEmpty(_createdBy)
        || !string.IsNullOrEmpty(_status);

    private int FirstOnPage => (_page.Page - 1) * _page.PageSize + 1;

    private int LastOnPage => Math.Min(_page.Page * _page.PageSize, _page.TotalCount);

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            var state = await AuthenticationState;
            _canWrite = (await Authorization.AuthorizeAsync(
                state.User, Permissions.BinRangesWrite)).Succeeded;
        }

        try
        {
            _options = await Api.GetFilterOptionsAsync();
        }
        catch (Exception ex)
        {
            // A failed dropdown load leaves the filters usable as "Any", so the listing
            // is still worth attempting.
            _error = $"Could not load filter options: {ex.Message}";
        }

        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        try
        {
            _page = await Api.SearchAsync(new BinRangeQuery
            {
                Prefix = _prefix,
                CardScheme = _cardScheme,
                ProductType = _productType,
                FundingType = _fundingType,
                CountryCode = _countryCode,
                CreatedBy = _createdBy,
                Status = string.IsNullOrEmpty(_status)
                    ? null
                    : Enum.Parse<BinRangeStatus>(_status),
                Page = _currentPage,
                PageSize = _pageSize
            });

            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Could not load BIN ranges: {ex.Message}";
            _page = new PagedResult<BinRangeListItem>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadFromFirstPage()
    {
        _currentPage = 1;
        await Load();
    }

    private void OnPrefixInput(ChangeEventArgs e) => _prefix = e.Value?.ToString() ?? string.Empty;

    private async Task OnPrefixKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ReloadFromFirstPage();
        }
    }

    private async Task ApplyFilter(Action<string> set, ChangeEventArgs e)
    {
        set(e.Value?.ToString() ?? string.Empty);
        await ReloadFromFirstPage();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        _status = e.Value?.ToString() ?? string.Empty;
        await ReloadFromFirstPage();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        _pageSize = int.TryParse(e.Value?.ToString(), out var size)
            ? size
            : BinRangeQuery.DefaultPageSize;

        await ReloadFromFirstPage();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _page.TotalPages) return;

        _currentPage = page;
        await Load();
    }

    private async Task ClearFilters()
    {
        _prefix = _cardScheme = _productType = _fundingType = string.Empty;
        _countryCode = _createdBy = _status = string.Empty;
        await ReloadFromFirstPage();
    }

    // ---- Maintenance -----------------------------------------------------------

    private void StartAdd()
    {
        _editing = null;
        _notice = null;
        _editorOpen = true;
    }

    private void StartEdit(BinRangeListItem item)
    {
        _editing = item;
        _notice = null;
        _editorOpen = true;
    }

    private void CloseEditor()
    {
        _editorOpen = false;
        _editing = null;
    }

    // Opens the read-only details for one range, re-fetching it by id so a deleted range can be
    // looked at in full before deciding whether to restore it, and so the values shown are the
    // stored ones rather than a possibly stale list row.
    private async Task View(BinRangeListItem item)
    {
        _viewing = item;
        _viewError = null;
        _notice = null;

        try
        {
            var fresh = await Api.GetAsync(item.BinRangeId);

            if (fresh is null)
            {
                _viewError = "This range no longer exists. It may have been removed since the list loaded.";
            }
            else
            {
                _viewing = fresh;
            }
        }
        catch (Exception ex)
        {
            _viewError = $"Could not load the latest values: {ex.Message}";
        }
    }

    private void CloseView() => _viewing = null;

    private async Task RestoreFromView(BinRangeListItem item)
    {
        CloseView();
        await Run(() => Api.RestoreAsync(item.BinRangeId));
    }

    // Reloads rather than patching the row in place: a change can move a range out of the current
    // filter or page, and a listing that disagrees with the database is worse than an extra call.
    private async Task OnSaved(BinRangeMutationResult result)
    {
        CloseEditor();

        var range = result.Range!;
        _notice = result.Status switch
        {
            BinRangeMutationStatus.Created => $"Added BIN range {range.Prefix}.",
            BinRangeMutationStatus.Updated => $"Saved BIN range {range.Prefix}.",
            BinRangeMutationStatus.Restored =>
                $"{range.Prefix} already existed as a deleted range. It has been restored with these values.",
            _ => $"BIN range {range.Prefix} saved."
        };

        await Load();
    }

    private async Task ConfirmDelete()
    {
        var item = _pendingDelete;
        if (item is null) return;

        await Run(() => Api.DeleteAsync(item.BinRangeId));

        _pendingDelete = null;
    }

    private Task Restore(BinRangeListItem item) => Run(() => Api.RestoreAsync(item.BinRangeId));

    private async Task Run(Func<Task<BinRangeMutationResult>> action)
    {
        _busy = true;
        _notice = null;

        try
        {
            var result = await action();

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            var range = result.Range!;
            _notice = result.Status == BinRangeMutationStatus.Deleted
                ? $"Deleted BIN range {range.Prefix}. Filter by Deleted to restore it."
                : $"Restored BIN range {range.Prefix}.";

            _error = null;
            await Load();
        }
        catch (Exception ex)
        {
            _error = $"The change could not be applied: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Date(DateTime value) => value.ToString("yyyy-MM-dd");

    // "system" is the placeholder recorded when nobody was signed in, not a user name.
    private static bool IsSystem(string? user) =>
        string.Equals(user, "system", StringComparison.OrdinalIgnoreCase);

    private static string LastChanged(BinRangeListItem item)
    {
        var who = IsSystem(item.UpdatedBy) ? "no signed-in user" : item.UpdatedBy ?? "unknown";

        return $"Last changed {Date(item.UpdatedAt)} by {who}";
    }

    private static string StatusColor(BinRangeStatus status) => status switch
    {
        BinRangeStatus.Active => "success",
        BinRangeStatus.Scheduled => "info",
        BinRangeStatus.Expired => "warning",
        BinRangeStatus.Deleted => "secondary",
        _ => "secondary"
    };
}
