@page "/audit"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.AuditRead)]
@inject AuditApiClient Api

<PageTitle>Audit Log</PageTitle>

<div class="page-head">
    <h1 class="h3 mb-1">Audit log</h1>
    <p class="text-secondary mb-0">
        Every change to a BIN range, role or role assignment, newest first. Entries are
        read-only - nothing here can be edited or removed from the application.
    </p>
</div>

<div class="filters card mt-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label" for="f-from">From</label>
                <input id="f-from" class="form-control" type="date"
                       value="@_from" @onchange="e => ApplyFilter(v => _from = v, e)" />
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label" for="f-to">To</label>
                <input id="f-to" class="form-control" type="date"
                       value="@_to" @onchange="e => ApplyFilter(v => _to = v, e)" />
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label" for="f-entity">Entity</label>
                <select id="f-entity" class="form-select" value="@_entityType"
                        @onchange="e => ApplyFilter(v => _entityType = v, e)">
                    <option value="">Any</option>
                    @foreach (var name in _entityTypes)
                    {
                        <option value="@name">@name</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label" for="f-action">Action</label>
                <select id="f-action" class="form-select" value="@_action"
                        @onchange="e => ApplyFilter(v => _action = v, e)">
                    <option value="">Any</option>
                    @foreach (var name in Enum.GetNames<AuditAction>())
                    {
                        <option value="@name">@name</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-6 col-lg-2">
                <label class="form-label" for="f-user">User</label>
                <input id="f-user" class="form-control" placeholder="e.g. admin"
                       value="@_userName" @oninput="OnUserInput" @onkeydown="OnUserKeyDown" />
            </div>
        </div>

        @if (HasNonDefaultFilters)
        {
            <button class="btn btn-link btn-sm px-0 mt-2" @onclick="ClearFilters">Clear filters</button>
        }
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger mt-4" role="alert">@_error</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 mb-2">
    <span class="text-secondary small">
        @if (_loading)
        {
            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            <span>Loading…</span>
        }
        else if (_page.TotalCount == 0)
        {
            <span>No entries match</span>
        }
        else
        {
            <span>
                @FirstOnPage–@LastOnPage of <strong class="text-body">@_page.TotalCount</strong>
                @(_page.TotalCount == 1 ? "entry" : "entries")
            </span>
        }
    </span>

    <div class="d-flex align-items-center gap-2">
        <label class="text-secondary small mb-0" for="f-size">Per page</label>
        <select id="f-size" style="min-width: 75px;" class="form-select form-select-sm w-auto" value="@_pageSize"
                @onchange="OnPageSizeChanged">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@if (!_loading && _page.TotalCount == 0 && _error is null)
{
    <div class="card empty-state">
        <div class="card-body text-center py-5">
            <p class="mb-1 fw-semibold">Nothing to show</p>
            <p class="text-secondary mb-0">
                No audit entries match these filters. Widen the date range or clear the
                filters to see the latest activity.
            </p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3" style="width: 3rem;"></th>
                        <th>When</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Id</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _page.Items)
                    {
                        <tr>
                            <td class="ps-3">
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        aria-expanded="@(_expanded.Contains(item.AuditEntryId) ? "true" : "false")"
                                        aria-controls="row-@item.AuditEntryId"
                                        @onclick="() => Toggle(item.AuditEntryId)">
                                    @(_expanded.Contains(item.AuditEntryId) ? "−" : "+")
                                </button>
                            </td>
                            <td>
                                <span>@Local(item.PerformedAt)</span>
                                <span class="text-secondary small d-block" title="UTC">@Utc(item.PerformedAt)</span>
                            </td>
                            <td>
                                @if (IsSystem(item.UserName))
                                {
                                    <span class="badge rounded-pill text-bg-light">System</span>
                                }
                                else
                                {
                                    <span class="fw-semibold">@item.UserName</span>
                                }
                            </td>
                            <td>
                                <span class="badge rounded-pill text-bg-@ActionColor(item.Action)">
                                    @item.Action
                                </span>
                            </td>
                            <td>@item.EntityType</td>
                            <td class="text-secondary"><code class="mono">@item.EntityId</code></td>
                        </tr>
                        @if (_expanded.Contains(item.AuditEntryId))
                        {
                            <tr id="row-@item.AuditEntryId" class="audit-detail">
                                <td class="ps-3"></td>
                                <td colspan="5">
                                    <div class="row g-3">
                                        <div class="col-12 col-lg-6">
                                            <div class="text-secondary small mb-1">Before</div>
                                            <pre class="audit-json mb-0">@Pretty(item.OldValues)</pre>
                                        </div>
                                        <div class="col-12 col-lg-6">
                                            <div class="text-secondary small mb-1">After</div>
                                            <pre class="audit-json mb-0">@Pretty(item.NewValues)</pre>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_page.TotalPages > 1)
    {
        <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Audit log pages">
            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="() => GoToPage(_page.Page - 1)"
                    disabled="@(_loading || !_page.HasPrevious)">
                Previous
            </button>

            <span class="text-secondary small">Page @_page.Page of @_page.TotalPages</span>

            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="() => GoToPage(_page.Page + 1)"
                    disabled="@(_loading || !_page.HasNext)">
                Next
            </button>
        </nav>
    }
}

@code {
    private const string EmptyMarker = "—";

    private bool _loading = true;
    private string? _error;

    private IReadOnlyList<string> _entityTypes = Array.Empty<string>();
    private PagedResult<AuditLogItem> _page = new();

    // The default window keeps the list interesting: a fresh open shows the last week
    // rather than the very first entries ever recorded.
    private string _from = DateTime.UtcNow.Date.AddDays(-7).ToString("yyyy-MM-dd");
    private string _to = string.Empty;
    private string _entityType = string.Empty;
    private string _action = string.Empty;
    private string _userName = string.Empty;
    private int _pageSize = AuditQuery.DefaultPageSize;
    private int _currentPage = 1;

    // Which rows have their before/after opened. Kept per-id so page navigation and
    // filter changes reset it - the rows on the next page are different.
    private readonly HashSet<int> _expanded = new();

    private static readonly string DefaultFrom =
        DateTime.UtcNow.Date.AddDays(-7).ToString("yyyy-MM-dd");

    private bool HasNonDefaultFilters =>
        _from != DefaultFrom
        || !string.IsNullOrEmpty(_to)
        || !string.IsNullOrEmpty(_entityType)
        || !string.IsNullOrEmpty(_action)
        || !string.IsNullOrEmpty(_userName);

    private int FirstOnPage => (_page.Page - 1) * _page.PageSize + 1;

    private int LastOnPage => Math.Min(_page.Page * _page.PageSize, _page.TotalCount);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entityTypes = await Api.GetEntityTypesAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not load entity types: {ex.Message}";
        }

        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _expanded.Clear();

        try
        {
            _page = await Api.SearchAsync(new AuditQuery
            {
                From = ParseDate(_from),
                // The picker is a day; treat it as "up to and including that day" by
                // sending the next day at 00:00 UTC and letting the API's half-open
                // range include the whole selected day.
                To = ParseDate(_to) is { } to ? to.AddDays(1) : null,
                EntityType = string.IsNullOrEmpty(_entityType) ? null : _entityType,
                UserName = string.IsNullOrWhiteSpace(_userName) ? null : _userName,
                Action = string.IsNullOrEmpty(_action) ? null : Enum.Parse<AuditAction>(_action),
                Page = _currentPage,
                PageSize = _pageSize
            });

            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Could not load audit entries: {ex.Message}";
            _page = new PagedResult<AuditLogItem>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadFromFirstPage()
    {
        _currentPage = 1;
        await Load();
    }

    private async Task ApplyFilter(Action<string> set, ChangeEventArgs e)
    {
        set(e.Value?.ToString() ?? string.Empty);
        await ReloadFromFirstPage();
    }

    private void OnUserInput(ChangeEventArgs e) =>
        _userName = e.Value?.ToString() ?? string.Empty;

    private async Task OnUserKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ReloadFromFirstPage();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        _pageSize = int.TryParse(e.Value?.ToString(), out var size)
            ? size
            : AuditQuery.DefaultPageSize;

        await ReloadFromFirstPage();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _page.TotalPages) return;

        _currentPage = page;
        await Load();
    }

    private async Task ClearFilters()
    {
        _from = DefaultFrom;
        _to = _entityType = _action = _userName = string.Empty;
        await ReloadFromFirstPage();
    }

    private void Toggle(int id)
    {
        if (!_expanded.Add(id)) _expanded.Remove(id);
    }

    private static DateTime? ParseDate(string value) =>
        DateTime.TryParse(value, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
            out var parsed) ? parsed : null;

    private static string Local(DateTime utc) =>
        utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string Utc(DateTime utc) =>
        utc.ToString("yyyy-MM-dd HH:mm 'UTC'");

    private static bool IsSystem(string? user) =>
        string.Equals(user, "system", StringComparison.OrdinalIgnoreCase);

    private static string ActionColor(AuditAction action) => action switch
    {
        AuditAction.Created => "success",
        AuditAction.Updated => "info",
        AuditAction.Deleted => "danger",
        AuditAction.Deactivated => "warning",
        AuditAction.Imported => "primary",
        _ => "secondary"
    };

    /// <summary>
    /// Re-serialises the stored JSON with indentation. A malformed snapshot is shown as
    /// it was stored rather than dropped - a viewer that hides broken data is worse than
    /// one that shows it.
    /// </summary>
    private static string Pretty(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return EmptyMarker;

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }
}
