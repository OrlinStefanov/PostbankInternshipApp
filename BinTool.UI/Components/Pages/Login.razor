@page "/login"
@layout Layout.BareLayout
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using BinTool.Core.Authorization
@using BinTool.Core.Models.Auth
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject AuthApiClient AuthApi
@inject NavigationManager Nav

@*
    Static server rendering on purpose. A cookie can only be written while the HTTP
    response is still being built - by the time an interactive circuit is running there
    is no response left to add a Set-Cookie header to.
*@

<PageTitle>Sign in · BinTool</PageTitle>

<div class="login-shell">
    <div class="login-card card">
        <div class="card-body p-4">
            <h1 class="h4 mb-1">Sign in</h1>
            <p class="text-secondary small mb-4">BIN classification and commission configuration.</p>

            <EditForm Model="Input" method="post" OnValidSubmit="SignIn" FormName="login">
                <DataAnnotationsValidator />

                @if (_error is not null)
                {
                    <div class="alert alert-danger py-2 px-3 small" role="alert">@_error</div>
                }

                <div class="mb-3">
                    <label class="form-label" for="userName">User name</label>
                    <InputText id="userName" class="form-control" @bind-Value="Input.UserName"
                               autocomplete="username" autofocus />
                    <ValidationMessage For="() => Input.UserName" class="text-danger small" />
                </div>

                <div class="mb-4">
                    <label class="form-label" for="password">Password</label>
                    <InputText id="password" type="password" class="form-control"
                               @bind-Value="Input.Password" autocomplete="current-password" />
                    <ValidationMessage For="() => Input.Password" class="text-danger small" />
                </div>

                <button class="btn btn-primary w-100" type="submit">Sign in</button>
            </EditForm>

            <hr class="my-4" />

            <p class="text-secondary small mb-1 text-uppercase demo-heading">Demo accounts</p>
            <ul class="demo-list small mb-0">
                <li><code>admin</code> / <code>Admin@@123</code> — full access</li>
                <li><code>viewer</code> / <code>Viewer@@123</code> — read-only</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private string? _error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    /// <summary>
    /// Start the login page from a clean, signed-out state. The antiforgery token this form
    /// posts is bound to whoever is signed in when it renders, so a leftover cookie - a still
    /// valid session, or one whose token has expired - would render a token bound to the old
    /// identity and the POST would fail antiforgery. Clearing the cookie AND resetting
    /// <c>HttpContext.User</c> makes the token render for the anonymous caller the POST will
    /// actually present. This is also the natural "switch account" path.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/", forceLoad: true);
            /*await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
            HttpContext.User = new ClaimsPrincipal(new ClaimsIdentity());*/
        }
    }

    private async Task SignIn()
    {
        var outcome = await AuthApi.LoginAsync(Input.UserName, Input.Password);

        if (!outcome.Succeeded)
        {
            _error = outcome.Rejection is { Reason: LoginRejectionReason.LockedOut, LockoutEndsUtc: { } endsUtc }
                ? LoginMessages.LockedOut(RemainingMinutes(endsUtc))
                : LoginMessages.Rejected;
            return;
        }

        var login = outcome.Response!;

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, login.UserId),
            new(ClaimTypes.Name, login.UserName),
            new("full_name", login.FullName),

            // The API token rides inside the encrypted cookie rather than in local
            // storage, and stays reachable once the circuit takes over.
            new(AuthClaims.AccessToken, login.AccessToken)
        };

        claims.AddRange(login.Roles.Select(role => new Claim(ClaimTypes.Role, role)));

        // The permissions the API baked into the token, mirrored onto the cookie so the UI can
        // gate pages and controls on the same policies the API enforces.
        claims.AddRange(login.Permissions.Select(p => new Claim(PermissionClaimTypes.Permission, p)));

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity),
            new AuthenticationProperties
            {
                IsPersistent = false,

                // Tied to the token's own expiry, so the session cannot outlive it.
                ExpiresUtc = login.ExpiresAtUtc
            });

        Nav.NavigateTo(SafeReturnUrl(), forceLoad: true);
    }

    /// <summary>
    /// Whole minutes left on a lockout, rounded up and never below one, so the message reads
    /// "a minute" rather than "0 minutes" in the final seconds.
    /// </summary>
    private static int RemainingMinutes(DateTime lockoutEndsUtc)
    {
        var remaining = lockoutEndsUtc - DateTime.UtcNow;
        return remaining <= TimeSpan.Zero ? 1 : Math.Max(1, (int)Math.Ceiling(remaining.TotalMinutes));
    }

    /// <summary>
    /// Only same-site paths are honoured, so a crafted returnUrl cannot bounce a
    /// freshly signed-in user off to another site.
    /// </summary>
    private string SafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl)
            || !ReturnUrl.StartsWith('/')
            || ReturnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            return "/";
        }

        return ReturnUrl;
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Enter your user name.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}