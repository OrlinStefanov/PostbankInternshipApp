@page "/"

<PageTitle>BinTool</PageTitle>

<div class="page-head">
    <h1 class="h3 mb-1">BinTool</h1>
    <p class="text-secondary mb-0">
        Card BIN classification and commission configuration. Everything a lookup returns
        comes from the imported ranges - no scheme is hard-coded.
    </p>
</div>

<AuthorizeView>
    <Authorized>
        @* Only the cards a signed-in user can actually act on. Each route is guarded in
           its own right, so this is presentation rather than the control. *@
        <div class="entry-grid mt-4">
            <AuthorizeView Policy="@Permissions.BinClassify" Context="lookup">
                <Authorized>
                    <a class="entry" href="lookup">
                        <span class="entry-title">BIN lookup</span>
                        <span class="entry-text">
                            Classify a BIN against the stored ranges, and add an amount to
                            price it with the commission rule that matches the card.
                        </span>
                    </a>
                </Authorized>
            </AuthorizeView>

            <a class="entry" href="bin-ranges">
                <span class="entry-title">BIN ranges</span>
                <span class="entry-text">
                    Browse and filter what is stored, check whether a prefix is active,
                    scheduled, expired or withdrawn, and maintain ranges one at a time.
                </span>
            </a>

            <AuthorizeView Policy="@Permissions.BinRangesImport" Context="import">
                <Authorized>
                    <a class="entry" href="import">
                        <span class="entry-title">Import CSV</span>
                        <span class="entry-text">
                            Load a batch of ranges. Rows that clash with a stored record are
                            staged as conflicts for review instead of overwriting anything.
                        </span>
                    </a>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="@Permissions.ReferenceDataManage" Context="reference">
                <Authorized>
                    <a class="entry" href="reference-data">
                        <span class="entry-title">Reference data</span>
                        <span class="entry-text">
                            Add or retire card schemes, product types, funding types,
                            regions and countries without a code change.
                        </span>
                    </a>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="@Permissions.CommissionRulesRead" Context="commission">
                <Authorized>
                    <a class="entry" href="commission-rules">
                        <span class="entry-title">Commission rules</span>
                        <span class="entry-text">
                            Configure the pricing a lookup applies to an amount - a percentage
                            plus a fixed fee with a minimum, keyed on scheme, product and region.
                        </span>
                    </a>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="@Permissions.AuditRead" Context="audit">
                <Authorized>
                    <a class="entry" href="audit">
                        <span class="entry-title">Audit log</span>
                        <span class="entry-text">
                            Read the trail of who changed which BIN range, role or role
                            assignment, with the before and after of each change.
                        </span>
                    </a>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="@Permissions.RolesManage" Context="access">
                <Authorized>
                    <a class="entry" href="access-control">
                        <span class="entry-title">Access control</span>
                        <span class="entry-text">
                            Compose roles from the permission catalogue and assign them to
                            people. Changes reach a user on their next sign-in.
                        </span>
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="card mt-4">
            <div class="card-body">
                <p class="mb-3">Sign in to browse BIN ranges and import data.</p>
                <a class="btn btn-primary" href="login">Sign in</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
