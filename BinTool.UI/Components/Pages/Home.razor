@page "/"
@rendermode InteractiveServer
@inject BinRangeApiClient Api

<PageTitle>BinTool</PageTitle>

<div class="home">
    <AuthorizeView>
        <Authorized>
            @* Scheme mismatches: stored rows whose scheme contradicts the detector. Only shown
               when the scan actually finds something, so a healthy database has no callout at
               all. It sits above the title because it is the one thing on this screen that
               wants acting on rather than navigating to. The count is a decoration - a load
               failure hides it silently rather than showing a stale badge. *@
            <AuthorizeView Policy="@Permissions.BinRangesRead" Context="mismatch">
                <Authorized>
                    @if (_mismatchCount > 0)
                    {
                        <div class="alarm">
                            <div class="alarm-said">
                                <span class="alarm-count">
                                    @_mismatchCount @(_mismatchCount == 1 ? "mismatch" : "mismatches")
                                </span>
                                <span class="alarm-text">
                                    @_mismatchCount stored BIN
                                    @(_mismatchCount == 1 ? "range has a scheme" : "ranges have a scheme")
                                    that contradicts the detected card prefix — these may cause
                                    incorrect routing or fee calculations.
                                </span>
                            </div>
                            <a class="btn btn-warning btn-sm" href="scheme-mismatches">Review</a>
                        </div>
                    }
                </Authorized>
            </AuthorizeView>

            <div class="home-head">
                <h2>BinTool</h2>
                <p>Card-BIN classification and pricing administration — Payments Operations</p>
            </div>

            @* Only the cards a signed-in user can actually act on. Each route is guarded in
               its own right, so this is presentation rather than the control. *@
            <div class="entry-grid">
                <AuthorizeView Policy="@Permissions.BinClassify" Context="lookup">
                    <Authorized>
                        <a class="entry" href="lookup">
                            <span class="ico ico-lookup entry-icon" aria-hidden="true"></span>
                            <span class="entry-title">BIN Lookup</span>
                            <span class="entry-text">
                                Classify a card number and calculate commission
                            </span>
                        </a>
                    </Authorized>
                </AuthorizeView>

                <a class="entry" href="bin-ranges">
                    <span class="ico ico-ranges entry-icon" aria-hidden="true"></span>
                    <span class="entry-title">BIN Ranges</span>
                    <span class="entry-text">
                        Browse and manage stored BIN prefix ranges
                    </span>
                </a>

                <AuthorizeView Policy="@Permissions.BinRangesRead" Context="mismatchEntry">
                    <Authorized>
                        <a class="entry" href="scheme-mismatches">
                            <span class="ico ico-warning entry-icon" aria-hidden="true"></span>
                            <span class="entry-title">Scheme mismatches</span>
                            <span class="entry-text">
                                Stored ranges whose scheme contradicts their prefix
                            </span>
                        </a>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@Permissions.BinRangesImport" Context="import">
                    <Authorized>
                        <a class="entry" href="import">
                            <span class="ico ico-import entry-icon" aria-hidden="true"></span>
                            <span class="entry-title">Import CSV</span>
                            <span class="entry-text">
                                Upload a CSV file to batch-import BIN ranges
                            </span>
                        </a>

                        <a class="entry" href="import-history">
                            <span class="ico ico-history entry-icon" aria-hidden="true"></span>
                            <span class="entry-title">Import History</span>
                            <span class="entry-text">
                                Review past imports and resolve conflicts
                            </span>
                        </a>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@Permissions.CommissionRulesRead" Context="commission">
                    <Authorized>
                        <a class="entry" href="commission-rules">
                            <span class="ico ico-commission entry-icon" aria-hidden="true"></span>
                            <span class="entry-title">Commission Rules</span>
                            <span class="entry-text">
                                Set fee rules by scheme, product and region
                            </span>
                        </a>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@Permissions.ReferenceDataManage" Context="reference">
                    <Authorized>
                        <a class="entry" href="reference-data">
                            <span class="ico ico-reference entry-icon" aria-hidden="true"></span>
                            <span class="entry-title">Reference Data</span>
                            <span class="entry-text">
                                Manage schemes, products, regions and countries
                            </span>
                        </a>

                        <a class="entry" href="currencies">
                            <span class="ico ico-currency entry-icon" aria-hidden="true"></span>
                            <span class="entry-title">Currencies</span>
                            <span class="entry-text">
                                Manage supported currencies and exchange rates
                            </span>
                        </a>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@Permissions.AuditRead" Context="audit">
                    <Authorized>
                        <a class="entry" href="audit">
                            <span class="ico ico-audit entry-icon" aria-hidden="true"></span>
                            <span class="entry-title">Audit Log</span>
                            <span class="entry-text">
                                Full history of every change made in the system
                            </span>
                        </a>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@Permissions.RolesManage" Context="access">
                    <Authorized>
                        <a class="entry" href="access-control">
                            <span class="ico ico-access entry-icon" aria-hidden="true"></span>
                            <span class="entry-title">Access Control</span>
                            <span class="entry-text">
                                Users, roles, and permission assignments
                            </span>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="home-head">
                <h2>BinTool</h2>
                <p>Card-BIN classification and pricing administration — Payments Operations</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <p class="mb-3">Sign in to browse BIN ranges and import data.</p>
                    <a class="btn btn-primary" href="login">Sign in</a>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private int _mismatchCount;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [Inject]
    private IAuthorizationService Authorization { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Only fetch the count when the signed-in user can actually see the scheme-mismatch
        // page - an unauthenticated visitor or one without BinRangesRead has no card to
        // render, so there is no reason to make the API call.
        if (AuthenticationState is null) return;

        var state = await AuthenticationState;
        if (state.User.Identity is not { IsAuthenticated: true }) return;

        var canRead = (await Authorization.AuthorizeAsync(
            state.User, Permissions.BinRangesRead)).Succeeded;
        if (!canRead) return;

        _mismatchCount = await Api.CountSchemeMismatchesAsync();
    }
}
