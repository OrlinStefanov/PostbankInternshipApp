@page "/lookup"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.BinClassify)]
@using System.Globalization
@using BinTool.Application.Models.Classification
@using BinTool.Application.Models.Commission
@using BinTool.Application.Models.Currency
@inject BinLookupApiClient Api
@inject CurrencyApiClient CurrencyApi

<PageTitle>BIN lookup</PageTitle>

<div class="page-head">
    <h1 class="h3 mb-1">BIN lookup</h1>
    <p class="text-secondary mb-0">
        Classify a BIN against the stored ranges. Add an amount to also price it: the most
        specific commission rule that matches the card is applied, falling back to the
        configured default. Everything returned comes from data - no scheme is hard-coded.
    </p>
</div>

<div class="card mt-4">
    <div class="card-body">
        <EditForm Model="_input" OnValidSubmit="Classify" FormName="bin-lookup">
            <DataAnnotationsValidator />

            <div class="row g-3 align-items-start">
                <div class="col-12 col-md-6 col-lg-5">
                    <label class="form-label" for="l-bin">BIN or card number</label>
                    <InputText id="l-bin" class="form-control mono" inputmode="numeric"
                               placeholder="6 to 19 digits" @bind-Value="_input.Bin" />
                    <div class="form-text">
                        Only the leading 8 digits are used; the rest is discarded before the lookup.
                    </div>
                    <ValidationMessage For="() => _input.Bin" class="form-text text-danger" />
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <label class="form-label" for="l-amount">Amount <span class="text-secondary">(optional)</span></label>
                    <div class="input-group">
                        <InputNumber id="l-amount" class="form-control" step="0.01"
                                     placeholder="e.g. 100" @bind-Value="_input.Amount" />
                        <InputSelect class="form-select flex-grow-0 w-auto" aria-label="Amount currency"
                                     @bind-Value="_input.AmountCurrency">
                            @* Named "currency", not "code": @code is the Razor directive. *@
                            @foreach (var currency in CurrencyCodes)
                            {
                                <option value="@currency">@currency</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-text">Leave empty to classify without pricing. Amounts also show in euro.</div>
                    <ValidationMessage For="() => _input.Amount" class="form-text text-danger" />
                </div>

                <div class="col-12 col-lg-3">
                    <span class="form-label d-none d-lg-block" aria-hidden="true">&nbsp;</span>
                    <button type="submit" class="btn btn-primary" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        Classify
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger mt-4" role="alert">@_error</div>
}

@if (_result is { Matched: true })
{
    <div class="card mt-4 lookup-card-panel">
        <div class="card-body">
            <BinCard Kind="Classified card"
                     Scheme="@_result.CardScheme"
                     StatusLabel="Matched"
                     StatusTone="success"
                     Prefix="@_result.Bin"
                     Tagline="@Tagline"
                     NumberNote="@($"Matched on prefix {_result.MatchedPrefix}")"
                     ValidFrom="_result.ValidFrom"
                     ValidTo="_result.ValidTo"
                     CountryCode="@_result.CountryCode"
                     CountryName="@_result.CountryName"
                     Region="@_result.Region"
                     ProductType="@_result.ProductType"
                     FundingType="@_result.FundingType"
                     Hint="Drag the card to turn it and read the strip">
                <ExtraDetails>
                    <div>
                        <dt>BIN used</dt>
                        <dd>@_result.Bin</dd>
                    </div>
                    <div>
                        <dt>Matched prefix</dt>
                        <dd>@_result.MatchedPrefix</dd>
                    </div>
                </ExtraDetails>
            </BinCard>
        </div>
    </div>
}

@if (_result is not null)
{
    <div class="row g-4 mt-0">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span class="fw-semibold">Classification</span>
                    @if (_result.Matched)
                    {
                        <span class="badge rounded-pill text-bg-success">Matched</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill text-bg-secondary">No match</span>
                    }
                </div>
                <div class="card-body">
                    @if (_result.Matched)
                    {
                        <dl class="detail-list">
                            <dt>BIN used</dt>
                            <dd><code class="mono">@_result.Bin</code></dd>

                            <dt>Matched prefix</dt>
                            <dd><code class="mono">@_result.MatchedPrefix</code></dd>

                            <dt>Scheme</dt>
                            <dd>
                                @_result.CardScheme
                                @if (_result.DetectedScheme is not null)
                                {
                                    <span class="badge rounded-pill text-bg-warning ms-1"
                                          title="@($"The matched prefix looks like {_result.DetectedScheme}, not {_result.CardScheme}. The stored range's scheme is likely wrong.")">
                                        ! @_result.DetectedScheme
                                    </span>
                                }
                            </dd>

                            <dt>Product</dt>
                            <dd>@_result.ProductType</dd>

                            <dt>Funding</dt>
                            <dd>@_result.FundingType</dd>

                            <dt>Country</dt>
                            <dd>@_result.CountryCode — @_result.CountryName</dd>

                            <dt>Region</dt>
                            <dd>@_result.Region</dd>

                            <dt>Valid</dt>
                            <dd>
                                @Date(_result.ValidFrom)
                                to @(_result.ValidTo is null ? OpenEnded : Date(_result.ValidTo))
                            </dd>
                        </dl>
                    }
                    else
                    {
                        <p class="mb-1">
                            No BIN range covers <code class="mono">@_result.Bin</code>.
                        </p>
                        <p class="text-secondary small mb-0">
                            Nothing is known about the card beyond the digits supplied. A range
                            that has expired, not started, or been withdrawn is not matched.
                        </p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span class="fw-semibold">Commission</span>
                    @if (_result.Commission is { IsFallback: true })
                    {
                        <span class="badge rounded-pill text-bg-warning" title="No rule matched the card; the configured default was used">
                            Default
                        </span>
                    }
                    else if (_result.Commission is not null)
                    {
                        <span class="badge rounded-pill text-bg-success">Rule matched</span>
                    }
                </div>
                <div class="card-body">
                    @if (_result.Commission is { } c)
                    {
                        <div class="mb-3">
                            <div class="text-secondary small">Fee</div>
                            <div class="h4 mb-0 mono">@Money(c.Fee, c.CurrencyCode)</div>
                            @if (!IsEuro(c.CurrencyCode))
                            {
                                <div class="mono text-secondary">≈ @Money(c.FeeEur, "EUR")</div>
                            }
                            <div class="text-secondary small">
                                applied by <span class="fw-semibold">@c.AppliedRuleName</span>
                            </div>
                        </div>

                        @if (!string.Equals(c.InputCurrencyCode, c.CurrencyCode, StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="alert alert-info py-2 small" role="alert">
                                The @Money(c.InputAmount, c.InputCurrencyCode) entered was converted to
                                @Money(c.Amount, c.CurrencyCode) to apply this rule's pricing.
                            </div>
                        }

                        <dl class="detail-list">
                            <dt>Amount</dt>
                            <dd class="mono">@MoneyDual(c.Amount, c.CurrencyCode, c.AmountEur)</dd>

                            <dt>Percentage rate</dt>
                            <dd class="mono">@Num(c.PercentageRate)%</dd>

                            <dt>Fixed amount</dt>
                            <dd class="mono">@MoneyDual(c.FixedAmount, c.CurrencyCode, c.FixedAmountEur)</dd>

                            <dt>Raw fee</dt>
                            <dd class="mono">@MoneyDual(c.RawFee, c.CurrencyCode, c.RawFeeEur)</dd>

                            <dt>Minimum fee</dt>
                            <dd class="mono">@MoneyDual(c.MinimumFee, c.CurrencyCode, c.MinimumFeeEur)</dd>

                            <dt>Minimum applied</dt>
                            <dd>@(c.MinimumApplied ? "Yes" : "No")</dd>

                            @* The arithmetic itself, one line per step. The figures above say
                               what went into the fee; this says what was done with them, so a
                               reader can check the number rather than take it on trust. *@
                            <dt class="detail-wide">How the fee was worked out</dt>
                            <dd class="detail-wide">
                                <ul class="fee-working">
                                    @foreach (var step in Working(c))
                                    {
                                        <li>
                                            <span class="fee-working-expr mono">@step.Expression</span>
                                            <span class="fee-working-note">@step.Note</span>
                                        </li>
                                    }
                                </ul>
                            </dd>

                            @* The reason is a sentence, not a value - it takes the full width
                               and reads left to right like prose. *@
                            <dt class="detail-wide">Why</dt>
                            <dd class="detail-wide">@c.Reason</dd>
                        </dl>
                    }
                    else if (_amountAsked)
                    {
                        <p class="mb-1">No commission was worked out.</p>
                        <p class="text-secondary small mb-0">
                            @(_result.Matched
                                ? "The card matched, but no commission rule covers it and no default rule is configured."
                                : "The BIN did not match a range, so there is no card to price.")
                        </p>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">
                            No amount was supplied. Enter one above to price this card.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string OpenEnded = "—";

    private BinClassificationRequest _input = new() { AmountCurrency = "EUR" };
    private BinClassificationResult? _result;
    private List<CurrencyListItem> _currencies = new();
    private bool _amountAsked;
    private bool _busy;
    private string? _error;

    // The codes offered in the amount selector. Euro is offered even when the list could not be
    // loaded - a role that cannot read currencies can still price in euro, rather than facing a
    // selector with nothing in it and no way to submit an amount.
    private IEnumerable<string> CurrencyCodes =>
        _currencies.Count > 0 ? _currencies.Select(c => c.Code) : new[] { "EUR" };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currencies = (await CurrencyApi.SearchAsync(includeDeleted: false))
                .Where(c => c.IsActive).ToList();
        }
        catch
        {
            // The currency list only drives the amount selector; a failure to load it should
            // not stop a plain classification. Euro is assumed when the list is empty.
            _currencies = new();
        }

        // Prefer euro as the pre-selected currency; otherwise the first one offered.
        if (_currencies.All(c => !string.Equals(c.Code, _input.AmountCurrency, StringComparison.OrdinalIgnoreCase)))
        {
            _input.AmountCurrency = _currencies.FirstOrDefault()?.Code ?? "EUR";
        }
    }

    private async Task Classify()
    {
        _busy = true;
        _error = null;

        try
        {
            // Remembered from the request, not read back off the result, so the "no amount"
            // and "amount but no price" cases can be told apart when the response is null.
            _amountAsked = _input.Amount is not null;

            _result = await Api.ClassifyAsync(_input);
        }
        catch (Exception ex)
        {
            _result = null;
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // The line printed under the number on the card: funding first, because "debit or credit" is
    // the thing a payment flow branches on before anything else.
    private string Tagline =>
        string.Join(" · ", new[] { _result?.FundingType, _result?.ProductType }
            .Where(v => !string.IsNullOrWhiteSpace(v)));

    // ---- The working -----------------------------------------------------------

    private sealed record FeeStep(string Expression, string Note);

    // The fee restated as the steps that produced it. Nothing here is recalculated from the rule -
    // every figure is one the server returned, so the lines agree with the values listed above them
    // even where the server rounded partway through.
    private static IReadOnlyList<FeeStep> Working(CommissionCalculation c)
    {
        var steps = new List<FeeStep>();
        var code = c.CurrencyCode;

        if (!string.Equals(c.InputCurrencyCode, code, StringComparison.OrdinalIgnoreCase))
        {
            steps.Add(new(
                $"{Money(c.InputAmount, c.InputCurrencyCode)} → {Money(c.Amount, code)}",
                "the amount entered, converted into the rule's currency"));
        }

        // Read back off the raw fee rather than worked out again from the rate: the server
        // rounds the percentage part to 4dp before adding the fixed amount, so recomputing it
        // here could print a sum that does not quite add up to the raw fee shown above.
        var percentage = c.RawFee - c.FixedAmount;

        steps.Add(new(
            $"{Dec(c.Amount)} × {Num(c.PercentageRate)}% = {Dec(percentage)}",
            "the rule's percentage of the amount"));

        steps.Add(new(
            $"{Dec(percentage)} + {Dec(c.FixedAmount)} = {Money(c.RawFee, code)}",
            "plus the rule's fixed amount"));

        if (c.MinimumApplied)
        {
            steps.Add(new(
                $"{Dec(c.RawFee)} < {Dec(c.MinimumFee)} → {Money(c.Fee, code)}",
                "under the rule's minimum fee, so the minimum is charged instead"));
        }
        else if (c.MinimumFee > 0)
        {
            steps.Add(new(
                $"{Dec(c.RawFee)} ≥ {Dec(c.MinimumFee)} → {Money(c.Fee, code)}",
                "at or above the rule's minimum fee, so it stands"));
        }
        else
        {
            steps.Add(new(
                $"= {Money(c.Fee, code)}",
                "the fee charged; this rule sets no minimum"));
        }

        return steps;
    }

    // ---- Formatting ------------------------------------------------------------

    private static string Num(decimal value) => value.ToString("0.####", CultureInfo.InvariantCulture);

    // A bare figure in the working, always to at least two decimals so the sums line up, but not
    // truncated to two - a rate that carries more precision has to show it or the arithmetic on the
    // line would look wrong.
    private static string Dec(decimal value) => value.ToString("0.00##", CultureInfo.InvariantCulture);

    private static string Money(decimal value, string code) =>
        $"{value.ToString("0.00", CultureInfo.InvariantCulture)} {code}";

    private static string MoneyDual(decimal value, string code, decimal eur) =>
        IsEuro(code) ? Money(value, code) : $"{Money(value, code)} ≈ {Money(eur, "EUR")}";

    private static bool IsEuro(string code) => string.Equals(code, "EUR", StringComparison.OrdinalIgnoreCase);

    private static string Date(DateTime? value) =>
        value is null ? OpenEnded : value.Value.ToString("yyyy-MM-dd");
}
